NODE_ENV=development
PORT=3001

REDIS_URL=redis://localhost:6379

JWT_SECRET=<generate-a-random-secret>

FIREBASE_PROJECT_ID=<firebase-project-id>
# Local (emuladores): setear estas dos y dejar FIREBASE_SERVICE_ACCOUNT vacía. Debe ser el mismo
# project ID que frontend/.env.local (NEXT_PUBLIC_FIREBASE_PROJECT_ID) para que los ID tokens que
# emite el Auth Emulator pasen la verificación acá (`getAuth().verifyIdToken`, ver auth.service.ts).
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Producción/staging (sin emuladores): JSON del service account, nunca un valor real acá.
FIREBASE_SERVICE_ACCOUNT=<service-account-json>

STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_CONTRACT_ID=<deployed-contract-id>
STELLAR_OPERATOR_SECRET=<operator-secret-key>

RAVEN_URL=http://localhost:8000
