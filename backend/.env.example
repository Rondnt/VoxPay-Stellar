NODE_ENV=development
PORT=3001

REDIS_URL=redis://localhost:6379

JWT_SECRET=<generate-a-random-secret>

FIREBASE_PROJECT_ID=<firebase-project-id>
# Local (emulador): setear esta y dejar FIREBASE_SERVICE_ACCOUNT vacía.
FIRESTORE_EMULATOR_HOST=localhost:8080
# Producción/staging (sin emulador): JSON del service account, nunca un valor real acá.
FIREBASE_SERVICE_ACCOUNT=<service-account-json>

STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_CONTRACT_ID=<deployed-contract-id>
STELLAR_OPERATOR_SECRET=<operator-secret-key>

RAVEN_URL=http://localhost:8000
