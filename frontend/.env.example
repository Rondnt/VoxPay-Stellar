# Server-to-server API. No secrets are needed in the frontend.
API_URL=http://localhost:3001
# Browser-accessible Socket.IO URL (use your LAN IP when testing from a phone).
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_NETWORK=TESTNET

# Firebase Auth (login/registro/Google Sign-In). Con un proyecto real, estos vienen de
# Firebase Console -> Project settings -> General -> Your apps (Web app config).
NEXT_PUBLIC_FIREBASE_API_KEY=<api-key>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<project-id>
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<project-id>.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<sender-id>
NEXT_PUBLIC_FIREBASE_APP_ID=<app-id>

# Desarrollo local sin proyecto real: apuntan al Auth Emulator (`firebase emulators:start`,
# ver ../firebase.json). Dejar vacío/sin setear contra un proyecto de Firebase real.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# WalletConnect/Reown (cloud.reown.com) -- necesario para conectar wallets mobile (Freighter mobile,
# etc.) que no son extensiones de navegador. Gratis, requiere crear un proyecto en su dashboard.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=<project-id>
